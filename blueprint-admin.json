{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Canizales Consultores — prueba con panel de administración",
		"author": "juanseG1236"
	},
	"landingPage": "/wp-admin/themes.php?page=canizales-setup",
	"login": true,
	"preferredVersions": { "php": "8.2", "wp": "latest" },
	"features": { "networking": true },
	"steps": [
		{ "step": "setSiteOptions", "options": { "blogname": "Canizales Consultores", "blogdescription": "Insolvencia y reorganización empresarial" } },
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/juanseG1236/canizales-consultores-wp",
				"ref": "main",
				"path": "canizales"
			},
			"options": { "activate": true }
		},
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; canizales_run_seed( true, true ); wp_delete_post( 1, true );" }
	]
}
