{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "bosque", "name": "Verde bosque", "color": "#1A3029" },
				{ "slug": "bosque-oscuro", "name": "Verde bosque oscuro", "color": "#12231E" },
				{ "slug": "oliva", "name": "Verde oliva", "color": "#8AA12B" },
				{ "slug": "oliva-claro", "name": "Verde oliva claro", "color": "#A8BD4E" },
				{ "slug": "oliva-texto", "name": "Verde oliva (texto)", "color": "#5C6B1D" },
				{ "slug": "marfil", "name": "Marfil", "color": "#F6F3EB" },
				{ "slug": "crema", "name": "Crema", "color": "#EFEBE1" },
				{ "slug": "bronce", "name": "Bronce suave", "color": "#B7A17A" },
				{ "slug": "piedra", "name": "Piedra", "color": "#D9D4C6" },
				{ "slug": "carbon", "name": "Carbón", "color": "#17211D" },
				{ "slug": "gris", "name": "Gris texto", "color": "#4A554F" },
				{ "slug": "blanco", "name": "Blanco", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "fraunces",
					"name": "Fraunces (titulares)",
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces.woff2" ] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic.woff2" ] }
					]
				},
				{
					"slug": "garet",
					"name": "Garet (textos)",
					"fontFamily": "\"Garet\", \"Manrope\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Muy pequeño", "size": "0.78rem", "fluid": false },
				{ "slug": "small", "name": "Pequeño", "size": "0.92rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grande", "size": "1.3rem", "fluid": { "min": "1.15rem", "max": "1.4rem" } },
				{ "slug": "x-large", "name": "Muy grande", "size": "1.8rem", "fluid": { "min": "1.45rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Título de sección", "size": "3rem", "fluid": { "min": "2rem", "max": "3.1rem" } },
				{ "slug": "huge", "name": "Título de página", "size": "4.8rem", "fluid": { "min": "2.6rem", "max": "5rem" } },
				{ "slug": "display", "name": "Portada", "size": "6.4rem", "fluid": { "min": "3rem", "max": "6.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(3.5rem, 7vw, 6rem)" },
				{ "slug": "70", "name": "3XL", "size": "clamp(4.75rem, 10vw, 9rem)" }
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1240px"
		},
		"custom": {
			"radius": "3px",
			"line": "rgba(23, 33, 29, .14)",
			"line-light": "rgba(246, 243, 235, .16)"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|marfil",
			"text": "var:preset|color|carbon"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|garet",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(20px, 5vw, 48px)",
				"right": "clamp(20px, 5vw, 48px)"
			}
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|bosque" },
				"typography": {
					"fontFamily": "var:preset|font-family|fraunces",
					"fontWeight": "450",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge", "fontWeight": "400", "lineHeight": "1" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|oliva-texto" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|bosque" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|oliva",
					"text": "var:preset|color|carbon"
				},
				"border": { "radius": "3px" },
				"spacing": { "padding": { "top": "1.05em", "bottom": "1.05em", "left": "1.7em", "right": "1.7em" } },
				"typography": {
					"fontFamily": "var:preset|font-family|garet",
					"fontSize": "0.8rem",
					"fontWeight": "800",
					"letterSpacing": "0.12em",
					"lineHeight": "1.2",
					"textTransform": "uppercase"
				},
				":hover": { "color": { "background": "var:preset|color|oliva-claro", "text": "var:preset|color|carbon" } },
				":focus": { "outline": { "color": "var:preset|color|oliva", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": {
				"typography": { "fontSize": "var:preset|font-size|small" },
				"color": { "text": "var:preset|color|gris" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.92rem", "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|piedra" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|oliva", "width": "2px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.75rem" } },
				"typography": { "fontFamily": "var:preset|font-family|fraunces", "fontStyle": "italic", "fontSize": "var:preset|font-size|large" }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "inherit" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"typography": { "fontSize": "var:preset|font-size|x-small", "fontWeight": "800", "letterSpacing": "0.14em", "textTransform": "uppercase" },
				"color": { "text": "var:preset|color|oliva-texto" }
			}
		}
	},
	"customTemplates": [
		{ "name": "pagina-en-blanco", "title": "Página en blanco (diseño libre)", "postTypes": [ "page", "post" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" },
		{ "name": "llamado", "title": "Franja de llamado a la acción", "area": "uncategorized" }
	]
}
